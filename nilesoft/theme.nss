// ✦ Lost Galaxy — Nilesoft Shell theme (right-click menu)
// location: C:\Program Files\Nilesoft Shell\imports\theme.nss   (needs admin to edit)
// reload: hold Ctrl+Shift and right-click the desktop, or restart explorer
theme
{
	name = "modern"
	dark = true
	background
	{
		color = #11111b
		opacity = 85
		effect = 2
	}
	item
	{
		radius = 3
		text
		{
			normal = #cdd6f4
			select = #cba6f7
			normal.disabled = #6c7086
			select.disabled = #6c7086
		}
		back
		{
			select = #313244
		}
	}
	border
	{
		enabled = true
		size = 1
		color = #cba6f7
		radius = 6
	}
	separator
	{
		color = #313244
	}
	symbol
	{
		normal = #b4befe
		select = #cba6f7
	}
	font
	{
		name = "JetBrainsMono Nerd Font"
		size = 13
	}
	image.align = 2
}
